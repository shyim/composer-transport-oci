{
    "name": "shyim/composer-transport-oci",
    "description": "Publish Composer packages to OCI registries and install them with Composer.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.9"
    },
    "require-dev": {
        "composer/composer": "^2.9",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ComposerOci\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ComposerOci\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "ComposerOci\\Plugin",
        "plugin-modifies-downloads": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=5"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.1.0"
        }
    },
    "keywords": [
        "composer",
        "composer-plugin",
        "oci",
        "registry",
        "ghcr",
        "packages",
        "distribution"
    ],
    "homepage": "https://github.com/shyim/composer-transport-oci",
    "support": {
        "issues": "https://github.com/shyim/composer-transport-oci/issues",
        "source": "https://github.com/shyim/composer-transport-oci",
        "docs": "https://github.com/shyim/composer-transport-oci#readme"
    }
}
